{
  "info": {
    "name": "ReliablePay API Collection",
    "_postman_id": "7b2e84c1-6b83-4923-8c45-d36c2ef00192",
    "description": "Comprehensive Postman test collection for ReliablePay fault-tolerant payment processing system.\nCovers idempotent payment creation, replay, conflict detection (422), metrics telemetry, chaos engineering, experiment runner, and DLQ requeue.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "admin-secret-token",
      "type": "string"
    },
    {
      "key": "idempotencyKey",
      "value": "DEMO-KEY-884920",
      "type": "string"
    },
    {
      "key": "paymentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "experimentId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Create Payment (201 Created)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantRef\": \"ORD-DEMO-001\",\n  \"amount\": 500.00,\n  \"currency\": \"INR\",\n  \"mode\": \"PROTECTED\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payments",
          "host": ["{{baseUrl}}"],
          "path": ["api", "payments"]
        },
        "description": "Submits a new payment request. Returns 201 Created with initial state INITIATED."
      }
    },
    {
      "name": "02 - Replay Payment - Identical Payload (200 OK)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantRef\": \"ORD-DEMO-001\",\n  \"amount\": 500.00,\n  \"currency\": \"INR\",\n  \"mode\": \"PROTECTED\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payments",
          "host": ["{{baseUrl}}"],
          "path": ["api", "payments"]
        },
        "description": "Replays the exact same request with the same Idempotency-Key. Returns 200 OK with the cached payment record without creating duplicates."
      }
    },
    {
      "name": "03 - Replay Payment - Conflicting Payload (422 Unprocessable)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantRef\": \"ORD-DEMO-001\",\n  \"amount\": 999.00,\n  \"currency\": \"INR\",\n  \"mode\": \"PROTECTED\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payments",
          "host": ["{{baseUrl}}"],
          "path": ["api", "payments"]
        },
        "description": "Attempts to reuse the same Idempotency-Key with a conflicting amount (999.00 vs 500.00). Returns 422 Unprocessable Entity."
      }
    },
    {
      "name": "04 - Get Payment By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/payments/{{paymentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "payments", "{{paymentId}}"]
        },
        "description": "Fetches current payment lifecycle state, attempt count, and last error."
      }
    },
    {
      "name": "05 - Get Payment Events Audit Trail",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/payments/{{paymentId}}/events",
          "host": ["{{baseUrl}}"],
          "path": ["api", "payments", "{{paymentId}}", "events"]
        },
        "description": "Fetches immutable state transition audit history for the payment."
      }
    },
    {
      "name": "06 - Requeue Dead-Lettered Payment",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/payments/{{paymentId}}/requeue",
          "host": ["{{baseUrl}}"],
          "path": ["api", "payments", "{{paymentId}}", "requeue"]
        },
        "description": "Transitions a DEAD_LETTERED payment back to RETRYING for re-evaluation by the retry engine."
      }
    },
    {
      "name": "07 - Get Metrics Summary (with Latencies)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/metrics/summary",
          "host": ["{{baseUrl}}"],
          "path": ["api", "metrics", "summary"]
        },
        "description": "Returns aggregate payment counts, retry success rate, recovery MTTR, avgLatencyMs, p95LatencyMs, duplicate orders, and overcharged amount."
      }
    },
    {
      "name": "08 - Get Active Chaos Configuration",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/chaos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "chaos"]
        },
        "description": "Reads current mock-bank failure rates and simulated delays."
      }
    },
    {
      "name": "09 - Update Chaos Configuration",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-Admin-Token",
            "value": "{{adminToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"timeoutRate\": 0.2,\n  \"errorRate\": 0.1,\n  \"channelFailureRate\": 0.05,\n  \"chargeOnTimeoutProbability\": 0.5,\n  \"latencyMs\": 100\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/chaos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "chaos"]
        },
        "description": "Updates chaos simulation profile. Protected by X-Admin-Token."
      }
    },
    {
      "name": "10 - Run Benchmark Experiment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Admin-Token",
            "value": "{{adminToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"count\": 20,\n  \"concurrency\": 5,\n  \"duplicateSubmitRate\": 0.2,\n  \"chaos\": {\n    \"timeoutRate\": 0.2,\n    \"errorRate\": 0.1,\n    \"channelFailureRate\": 0.05,\n    \"chargeOnTimeoutProbability\": 0.5,\n    \"latencyMs\": 100\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/experiments/run",
          "host": ["{{baseUrl}}"],
          "path": ["api", "experiments", "run"]
        },
        "description": "Spawns an asynchronous head-to-head comparison run between NAIVE and PROTECTED protocols."
      }
    },
    {
      "name": "11 - Get Experiment Telemetry",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/experiments/{{experimentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "experiments", "{{experimentId}}"]
        },
        "description": "Fetches status (RUNNING, DONE, FAILED) and comparative telemetry metrics between NAIVE and PROTECTED modes."
      }
    },
    {
      "name": "12 - Admin Reset (Purge DB & Ledger)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Admin-Token",
            "value": "{{adminToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/reset",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "reset"]
        },
        "description": "Resets the database and mock-bank transaction ledger for a fresh clean benchmark."
      }
    }
  ]
}
