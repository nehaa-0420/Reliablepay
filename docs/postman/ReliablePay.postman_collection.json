{
  "info": {
    "name": "ReliablePay API Collection",
    "_postman_id": "7b2e84c1-6b83-4923-8c45-d36c2ef00192",
    "description": "Comprehensive Postman test collection for ReliablePay fault-tolerant payment processing system.\nCovers idempotent payment creation, replay, conflict detection (422), real-time SSE event streams, admin authentication layer (HMAC-SHA256), metrics telemetry, chaos engineering, experiment runner, and DLQ requeue.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "adminUsername",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "idempotencyKey",
      "value": "DEMO-KEY-884920",
      "type": "string"
    },
    {
      "key": "paymentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "experimentId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 - Admin Login (POST /api/auth/admin/login)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set('authToken', jsonData.token);",
              "    console.log('Saved authToken into collection variables');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/admin/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "admin", "login"]
        },
        "description": "Authenticates using ADMIN_USERNAME and ADMIN_PASSWORD. Returns an HMAC-SHA256 signed token valid for 8 hours. Rate-limited to 5 failures per minute per IP."
      }
    },
    {
      "name": "00b - Validate Admin Token (GET /api/auth/admin/me)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/admin/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "admin", "me"]
        },
        "description": "Validates active Bearer token or X-Admin-Token header."
      }
    },
    {
      "name": "01 - Create Payment (201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.id) {",
              "    pm.collectionVariables.set('paymentId', jsonData.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantRef\": \"ORD-DEMO-001\",\n  \"amount\": 500.00,\n  \"currency\": \"INR\",\n  \"mode\": \"PROTECTED\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payments",
          "host": ["{{baseUrl}}"],
          "path": ["api", "payments"]
        },
        "description": "Submits a new payment request. Returns 201 Created with initial state INITIATED."
      }
    },
    {
      "name": "02 - Replay Payment - Identical Payload (200 OK)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantRef\": \"ORD-DEMO-001\",\n  \"amount\": 500.00,\n  \"currency\": \"INR\",\n  \"mode\": \"PROTECTED\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payments",
          "host": ["{{baseUrl}}"],
          "path": ["api", "payments"]
        },
        "description": "Replays the exact same request with the same Idempotency-Key. Returns 200 OK with the cached payment record without creating duplicates."
      }
    },
    {
      "name": "03 - Replay Payment - Conflicting Payload (422 Unprocessable)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchantRef\": \"ORD-DEMO-001\",\n  \"amount\": 999.00,\n  \"currency\": \"INR\",\n  \"mode\": \"PROTECTED\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payments",
          "host": ["{{baseUrl}}"],
          "path": ["api", "payments"]
        },
        "description": "Attempts to reuse the same Idempotency-Key with a conflicting amount (999.00 vs 500.00). Returns 422 Unprocessable Entity."
      }
    },
    {
      "name": "04 - Get Payment By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/payments/{{paymentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "payments", "{{paymentId}}"]
        },
        "description": "Fetches current payment lifecycle state, attempt count, and last error."
      }
    },
    {
      "name": "05 - Get Payment Events Audit Trail",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/payments/{{paymentId}}/events",
          "host": ["{{baseUrl}}"],
          "path": ["api", "payments", "{{paymentId}}", "events"]
        },
        "description": "Fetches immutable state transition audit history for the payment."
      }
    },
    {
      "name": "05b - Customer Real-Time Payment Stream (SSE)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/event-stream"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/payments/{{paymentId}}/stream",
          "host": ["{{baseUrl}}"],
          "path": ["api", "payments", "{{paymentId}}", "stream"]
        },
        "description": "Connects to real-time Server-Sent Events stream for a specific payment. Emits initial snapshot, then live transitions until terminal status."
      }
    },
    {
      "name": "05c - Admin Global Event Stream (SSE)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/event-stream"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/stream",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "stream"]
        },
        "description": "Admin real-time SSE stream. Emits initial status counts + last 20 events snapshot, then broadcasts all system-wide payment transitions."
      }
    },
    {
      "name": "06 - Requeue Dead-Lettered Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/payments/{{paymentId}}/requeue",
          "host": ["{{baseUrl}}"],
          "path": ["api", "payments", "{{paymentId}}", "requeue"]
        },
        "description": "Transitions a DEAD_LETTERED payment back to RETRYING for re-evaluation by the retry engine. Requires admin authorization."
      }
    },
    {
      "name": "07 - Get Metrics Summary (with Latencies)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/metrics/summary",
          "host": ["{{baseUrl}}"],
          "path": ["api", "metrics", "summary"]
        },
        "description": "Returns aggregate payment counts, retry success rate, recovery MTTR, avgLatencyMs, p95LatencyMs, duplicate orders, and overcharged amount. Requires admin authorization."
      }
    },
    {
      "name": "08 - Get Active Chaos Configuration",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/chaos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "chaos"]
        },
        "description": "Reads current mock-bank failure rates and simulated delays. Requires admin authorization."
      }
    },
    {
      "name": "09 - Update Chaos Configuration",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"timeoutRate\": 0.2,\n  \"errorRate\": 0.1,\n  \"channelFailureRate\": 0.05,\n  \"chargeOnTimeoutProbability\": 0.5,\n  \"latencyMs\": 100\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/chaos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "chaos"]
        },
        "description": "Updates chaos simulation profile. Protected by Authorization Bearer token or X-Admin-Token."
      }
    },
    {
      "name": "10 - Run Benchmark Experiment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"count\": 20,\n  \"concurrency\": 5,\n  \"duplicateSubmitRate\": 0.2,\n  \"chaos\": {\n    \"timeoutRate\": 0.2,\n    \"errorRate\": 0.1,\n    \"channelFailureRate\": 0.05,\n    \"chargeOnTimeoutProbability\": 0.5,\n    \"latencyMs\": 100\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/experiments/run",
          "host": ["{{baseUrl}}"],
          "path": ["api", "experiments", "run"]
        },
        "description": "Spawns an asynchronous head-to-head comparison run between NAIVE and PROTECTED protocols. Protected by admin auth."
      }
    },
    {
      "name": "11 - Get Experiment Telemetry",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/experiments/{{experimentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "experiments", "{{experimentId}}"]
        },
        "description": "Fetches status (RUNNING, DONE, FAILED) and comparative telemetry metrics between NAIVE and PROTECTED modes."
      }
    },
    {
      "name": "12 - Admin Reset (Purge DB & Ledger)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/reset",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "reset"]
        },
        "description": "Resets the database and mock-bank transaction ledger for a fresh clean benchmark. Protected by admin auth."
      }
    }
  ]
}
